import java.io.*;

public class Q21_FileHandling {
    public static void main(String[] args) {
        try {
            // Writing into file
            FileWriter fw = new FileWriter("test.txt");
            fw.write("Hello Rani!\nThis is file handling program.");
            fw.close();

            // Reading from file
            FileReader fr = new FileReader("test.txt");
            int i;
            while((i = fr.read()) != -1) {
                System.out.print((char)i);
            }
            fr.close();

        } catch(Exception e) {
            System.out.println(e);
        }
    }
}
