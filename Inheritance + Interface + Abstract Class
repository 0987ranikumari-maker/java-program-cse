interface Animal {
    void sound();
}
abstract class Dog implements Animal {
    abstract void eat();

    public void sound() {
        System.out.println("Dog barks");
    }
}
class Puppy extends Dog {
    void eat() {
        System.out.println("Puppy drinks milk");
    }
}
public class Q22_InheritanceDemo {
    public static void main(String[] args) {
        Puppy p = new Puppy();
        p.sound();
        p.eat();
    }
}
