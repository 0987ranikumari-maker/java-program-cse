class TimeHM {
    int h, m;

    TimeHM(int h, int m) {
        this.h = h;
        this.m = m;
    }

    void add(TimeHM t) {
        int m = this.m + t.m;
        int h = this.h + t.h + m / 60;

        m = m % 60;

        System.out.println("Time = " + h + ":" + m);
    }
}

public class TimeHMMain {
    public static void main(String[] args) {
        TimeHM t1 = new TimeHM(5, 40);
        TimeHM t2 = new TimeHM(3, 30);
        t1.add(t2);
    }
}
